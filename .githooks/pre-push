#!/bin/sh
# Repo-local pre-push gate. Activated via `core.hooksPath=.githooks`
# (set by the `prepare` npm script).
#
# This is a FAST gate: it runs only the tests affected by the pushed commits
# (vitest --changed vs @{upstream}); the FULL build+test suite runs in GitHub
# Actions CI. Lint runs on pre-commit (lint-staged).
#
# Emergency bypass: git push --no-verify
set -e

echo 'pre-push: fast gate (affected tests)…'

# 1. Lockfile integrity — CI installs with --frozen-lockfile, which FAILS if
#    package.json and pnpm-lock.yaml disagree. Idempotent + fast when already in sync.
echo 'pre-push: pnpm install --frozen-lockfile'
pnpm install --frozen-lockfile

# 2. Run only tests affected by the commits being pushed.
base=$(git rev-parse --verify --quiet @{upstream} 2>/dev/null || true)
if [ -n "$base" ]; then
  echo "pre-push: running tests affected since $base"
  pnpm exec vitest run --changed "$base"
else
  echo 'pre-push: no upstream tracking branch — running full suite'
  pnpm test
fi

echo 'pre-push: ✔ fast gate passed — pushing.'
